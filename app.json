{
  "expo": {
    "scheme": "nirmala",
    "name": "nirmala",
    "slug": "nirmala",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#749174"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#749174"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.byantora.nirmala"
    },
    "web": {
      "favicon": "./assets/icons/nirmala-icon.svg"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Nirmala to access your camera to scan items during panic interventions."
        }
      ],
      "expo-build-properties"
    ]
  }
}
