{
  "expo": {
    "scheme": "nirmala",
    "name": "nirmala",
    "slug": "nirmala",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/nirmala-icon.svg",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icons/nirmala-icon.svg",
      "resizeMode": "contain",
      "backgroundColor": "#749174"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/nirmala-icon.svg",
        "backgroundColor": "#749174"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.mdetryalviano.nirmala"
    },
    "web": {
      "favicon": "./assets/icons/nirmala-icon.svg"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ]
  }
}
